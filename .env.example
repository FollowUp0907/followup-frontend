# 비워두면 같은 오리진(/api)으로 요청한다.
#  - 로컬 개발: vite dev server가 /api 를 백엔드로 프록시 (vite.config.ts)
#  - Vercel 배포: api/[...path].ts 프록시 함수가 BACKEND_ORIGIN 으로 전달
# 백엔드를 직접 호출하고 싶을 때만 값을 채운다. (백엔드 CORS 허용 필요)
VITE_API_BASE_URL=

# 로컬 dev server 프록시 대상. 배포된 백엔드를 보려면 그 주소를 넣는다.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# [Vercel 전용] api/[...path].ts 프록시 함수가 호출할 백엔드 오리진.
# 로컬에서는 쓰이지 않는다. (로컬은 위 VITE_DEV_PROXY_TARGET 을 쓴다)
# 백엔드 IP/도메인이 바뀌면 Vercel 대시보드에서 이 값만 바꾸고 재배포하면 된다.
# VITE_ 접두사가 없으므로 번들에 포함되지 않고 서버에서만 읽힌다.
BACKEND_ORIGIN=

# 구글 로그인 (선택)
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
# 비워 두면 로그인/회원가입 화면에 구글 버튼이 아예 표시되지 않는다.
VITE_GOOGLE_CLIENT_ID=

# 알림 SSE 전용 백엔드 주소. EventSource 는 프록시를 거치면 스트림이 고여서
# 백엔드에 직접 붙는다. 비워 두면 SSE 를 켜지 않고 폴링만 쓴다.
VITE_SSE_ORIGIN=https://est-followup-api.duckdns.org

# 웹 푸시 (Firebase Cloud Messaging) — 선택
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹)에서 가져온다. 모두 공개값이다.
# 하나라도 비어 있으면 알림 종에 "브라우저 알림 켜기" 가 나타나지 않는다.
# (서비스 계정 JSON 은 서버 전용 비밀키다. 여기에 절대 넣지 않는다)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=followup-f4335.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=followup-f4335
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
# 웹 푸시 인증서 공개키 (콘솔 > 클라우드 메시징 > 웹 푸시 인증서)
VITE_FIREBASE_VAPID_KEY=
